OPENROUTER_API_KEY=sk-or-your-key
OPENROUTER_MODEL=google/gemini-2.5-flash
# SQUARE_ACCESS_TOKEN=EAAA-your-sandbox-token

# Square is always sandbox-only. SQUARE_ENV cannot select production.
# Only use a Square sandbox token.
# Exact browser origin for reviewed mutation requests (default shown):
# PROFITSHIELD_ORIGIN=http://localhost:8000

# Owner authentication (required): exact HTTPS browser origin for hosting.
# PROFITSHIELD_ORIGIN=https://profitshield.example
# PROFITSHIELD_AUTH_DB=/private/persistent/owner-auth.sqlite3
# Local loopback development only: PROFITSHIELD_LOCAL_HTTP=1 and matching HTTP origin.
